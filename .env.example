# Copy to .env.local for local dev, and set the same keys in Vercel
# (Project -> Settings -> Environment Variables).

# ---- Square (required for the live menu + all checkout) ----------------
# developer.squareup.com/apps -> your app. Use SANDBOX values while testing.
SQUARE_ENVIRONMENT=sandbox            # "sandbox" or "production"
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=

# ---- Catering order notification email (optional) ---------------------
# If RESEND_API_KEY + ORDER_FROM_EMAIL are set, every started catering
# order is emailed (with allergies / address, which Square's note truncates).
# Resend (resend.com) - the FROM domain must be verified with them.
RESEND_API_KEY=
ORDER_FROM_EMAIL=orders@lunchbarbakehouse.com.au
ORDER_NOTIFY_EMAIL=hello@lunchbarbakehouse.com.au
