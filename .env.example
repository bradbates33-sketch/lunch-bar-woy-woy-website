# Copy to .env.local for local dev, and set the same keys in Vercel
# (Project -> Settings -> Environment Variables).

# ---- Square (required for the live menu + all checkout) ----------------
# developer.squareup.com/apps -> your app. Use SANDBOX values while testing.
SQUARE_ENVIRONMENT=sandbox            # "sandbox" or "production"
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=

# ---- Catering order emails (optional) ----------------------------------
# If RESEND_API_KEY + ORDER_FROM_EMAIL are set, each catering order is emailed
# to ORDER_NOTIFY_EMAIL: the invoice (Catering) or receipt (Kids Catering).
# Resend (resend.com) - the FROM domain must be verified with them.
RESEND_API_KEY=
ORDER_FROM_EMAIL=Lunch Bar <orders@lunchbarbakehouse.com.au>
ORDER_NOTIFY_EMAIL=hello@lunchbarbakehouse.com.au

# ---- Square webhook (optional, recommended) ----------------------------
# With this set, the email above is sent when Square confirms the card payment
# went through (pages/api/square-webhook.js) instead of when checkout starts.
# Signing key of the webhook subscription (Square Developer Console -> your
# app -> Webhooks -> Subscriptions).
SQUARE_WEBHOOK_SIGNATURE_KEY=
